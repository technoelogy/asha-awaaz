# ASHA Awaaz — environment
#
# Copy to .env.local and uncomment what you need. With nothing set, the app
# runs fully in mock/browser mode: no keys, safe for demos.

# ─── Structuring (Claude) ─────────────────────────────────────────────
# Set your Anthropic API key to enable the live structuring path.
# ANTHROPIC_API_KEY=sk-ant-...

# Haiku model string. Start on Haiku; move to Sonnet only if extraction misses.
# ASHA_MODEL=claude-haiku-4-5

# Force structuring mock mode even when a key is present (offline demos).
# ASHA_MOCK=1

# ─── Voice capture (where the transcript comes from) ──────────────────
# browser (default when unset, if the browser supports it) — real in-browser
#         speech-to-text, works TODAY in Chrome, no key.
# wispr   — record audio -> /api/transcribe -> Wispr REST (production socket).
# mock    — no mic; canned transcript for bulletproof demos.
# NEXT_PUBLIC_VOICE_SOURCE=browser

# ─── Wispr (only needed when NEXT_PUBLIC_VOICE_SOURCE=wispr) ───────────
# Set this when your Wispr org is verified and the key is issued.
# WISPR_API_KEY=...
# Override only if Wispr's endpoint differs from the default:
# WISPR_TRANSCRIBE_URL=https://api.wisprflow.ai/api/v1/transcribe
# Force transcribe mock even when a Wispr key is present:
# ASHA_VOICE_MOCK=1

# ─── Datastore (Supabase) ─────────────────────────────────────────────
# Leave unset and the app runs in-memory (confirmed notes vanish on refresh).
# Set both to persist confirmed notes as real rows. First run supabase-schema.sql
# in the Supabase SQL editor. Server-side only — the key never reaches the browser.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...   (Project Settings → API → service_role key)
